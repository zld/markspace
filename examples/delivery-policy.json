{
  "name": "level-delivery",
  "version": 1,
  "duration": {
    "tolerance_seconds": 0.02,
    "tolerance_ratio": 0.001,
    "start_severity": "warning"
  },
  "matching": {
    "pairs": [],
    "require_kinds": ["audio"],
    "ignore_kinds": ["timecode"],
    "match_by_index": false
  },
  "codec": {
    "enabled": true,
    "missing_severity": "info",
    "warn_fields": ["channels"],
    "ignore_fields": [],
    "whitelist": {
      "video": [
        {"codec": "h264", "width": 1920, "height": 1080},
        {"codec": "hevc", "width": 1920, "height": 1080}
      ],
      "audio": [
        {"codec": "aac", "sample_rate": 48000, "channels": 2},
        {"codec": "pcm_s16le", "sample_rate": 48000, "channels": 1}
      ],
      "subtitle": [
        {"codec": "tx3g"}
      ]
    }
  }
}
